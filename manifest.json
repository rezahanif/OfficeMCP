{
  "id": "office-mcp",
  "name": "Office Connector",
  "version": "1.0.5",
  "manifest_schema_version": 1,
  "package_format_version": 1,
  "platform": {
    "os": "windows",
    "arch": "x64"
  },
  "runtime": "python",
  "entry": "run_server.py",
  "min_app_version": "0.4.0",
  "entitlement_tier": "free",
  "port_env_var": "MCP_PORT",
  "token_env_var": "MCP_LICENSE_TOKEN",
  "stdio": true,
  "platform_requirements": {
    "windows": [
      "Windows 10/11",
      "Microsoft Office installed (COM automation)"
    ],
    "com": [
      "Office apps must be installed for COM tools; MCP server starts fine without them (structured TOOL_ERROR off-Windows)"
    ]
  },
  "tool_tiers": {
    "core": [
      "AvailableApps",
      "Launch",
      "get_error_hints",
      "search_office_api",
      "list_office_api_categories",
      "list_templates",
      "load_template",
      "doc_create",
      "doc_read",
      "xlsx_create",
      "xlsx_read_cells",
      "pptx_create",
      "pptx_read",
      "msp_create",
      "msp_open"
    ],
    "aliases_file": "officemcp/aiconnect_aliases.json"
  },
  "config": {
    "env": []
  }
}
